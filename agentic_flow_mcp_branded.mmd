flowchart LR
    U([User Query]):::user --> LG["LG  LangGraph Agent\nPlan · Route · Reason"]:::lang
    LG --> Q{"Need MCP?"}:::decision
    Q -- "No" --> R([Final Response]):::response

    Q -- "Yes" --> FM["M  FastMCP Client\nTool selection + invocation"]:::fastmcp
    FM --> FS["F  FastAPI MCP Server\nMCP protocol endpoint"]:::fastapi

    FS --> AWS["aws  AWS Services\nS3 · Lambda · Bedrock"]:::aws
    FS --> PS["Product Search API"]:::tool
    FS --> WS["Web/Search Tool"]:::tool
    FS --> DB["DB / Files / ETL"]:::tool

    AWS --> FS
    PS --> FS
    WS --> FS
    DB --> FS

    FS --> LG
    LG --> R

    classDef user fill:#ffffff,stroke:#94a3b8,stroke-width:1.5px,color:#0f172a;
    classDef lang fill:#eef2ff,stroke:#818cf8,stroke-width:2px,color:#1e1b4b;
    classDef decision fill:#fff7ed,stroke:#fb923c,stroke-width:2px,color:#7c2d12;
    classDef response fill:#ecfeff,stroke:#22d3ee,stroke-width:1.8px,color:#083344;
    classDef fastmcp fill:#f0fdf4,stroke:#22c55e,stroke-width:2px,color:#14532d;
    classDef fastapi fill:#f0f9ff,stroke:#06b6d4,stroke-width:2px,color:#164e63;
    classDef aws fill:#fff7ed,stroke:#f59e0b,stroke-width:2px,color:#451a03;
    classDef tool fill:#f8fafc,stroke:#cbd5e1,stroke-width:1.5px,color:#0f172a;
