# Chat model: openai | google | groq
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Astra DB retrieval and Google embeddings
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_KEYSPACE=

# Local services and retrieval gates
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_RELEVANCY_THRESHOLD=0.35
MCP_OVERLAP_THRESHOLD=0.15
CHROME_VERSION_MAIN=

# Local persistence and browser security
CHAT_HISTORY_DB=data/chat_history.db
REVIEWS_HISTORY_CSV=data/product_reviews_history.csv
POSTER_DIR=poster
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
COOKIE_SECURE=false
